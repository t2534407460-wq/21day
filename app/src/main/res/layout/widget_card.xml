<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/card_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:paddingBottom="20dp" android:background="@drawable/widget_card_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/card_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/card_index" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/widget_muted" android:textSize="11sp" android:fontFamily="sans-serif-medium" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:gravity="center_vertical">
        <TextView android:id="@+id/card_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/widget_ink" android:textSize="22sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/card_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/widget_ink" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/card_goal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/widget_muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/card_divider" android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_edge" />
    <TextView android:id="@+id/card_action" android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:textColor="@color/widget_ink" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
