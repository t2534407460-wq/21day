<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@android:id/background" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/small_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="廿一 · 打卡" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/widget_header" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/small_edit" android:layout_width="28dp" android:layout_height="28dp" android:gravity="center" android:text="✎" android:textSize="18sp" android:textColor="@color/widget_header_muted" android:contentDescription="选择打卡按钮习惯" />
    </LinearLayout>
    <TextView android:id="@+id/small_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="次数 / 区间打卡" android:textSize="10sp" android:textColor="@color/widget_header_muted" android:maxLines="1" />
    <TextView android:id="@+id/small_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="选择一个习惯" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/widget_header" android:maxLines="1" android:ellipsize="end" android:layout_marginBottom="5dp" />
    <TextView android:id="@+id/small_action" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="选择习惯" android:textSize="14sp" android:textStyle="bold" android:textColor="#21382B" android:background="@drawable/widget_button_background" android:maxLines="2" />
    <TextView android:id="@+id/small_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="5dp" android:text="点按准备 · 再次确认" android:textSize="9sp" android:textColor="@color/widget_header_muted" android:maxLines="1" />
</LinearLayout>
